# Required for any non-health endpoint. Generate a local value; never commit .env.
FINAL_API_TOKEN=replace-with-a-long-local-secret
FINAL_API_PRINCIPAL=local-operator

# Lab 01 vLLM OpenAI-compatible server.
FINAL_VLLM_BASE_URL=http://127.0.0.1:8000
FINAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
FINAL_REQUEST_TIMEOUT_MS=45000

# Server-side authorization. A caller cannot select a knowledge base outside this list.
FINAL_ALLOWED_KNOWLEDGE_BASES=operations-public
FINAL_ALLOWED_SCOPES=internal

# The ingestion command chooses this explicitly after corpus/license review.
# FINAL_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
